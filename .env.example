# Non-secret defaults for the browser UI.
# Do not place provider API keys in Vite env vars for production builds.
# Use the runtime input field or a backend proxy instead.

# Provider: qwen | openai | custom
VITE_LLM_PROVIDER=

# Optional model override. Leave empty to use the provider default.
VITE_LLM_MODEL=

# Optional base URL override. Required only for custom provider mode.
VITE_LLM_BASE_URL=

# Optional override for the app backend base URL.
# Leave empty in local dev and let Vite proxy /api to http://127.0.0.1:8787.
VITE_APP_API_BASE=

# Optional local HTTP/HTTPS proxy for the Node backend when it needs to
# request external model endpoints such as /v1/models.
# Example on Windows with Clash/Meta:
# APP_HTTP_PROXY=http://127.0.0.1:10809
APP_HTTP_PROXY=
