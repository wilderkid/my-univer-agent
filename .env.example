# ── LLM 配置（填写后刷新页面自动连接，无需手动输入）─────────────────────────

# 提供商：qwen | openai | custom（默认 qwen）
VITE_LLM_PROVIDER=

# API Key
# 通义千问（DashScope）：https://dashscope.aliyun.com/
# OpenAI：https://platform.openai.com/api-keys
VITE_LLM_API_KEY=

# 模型名称（可选，留空使用提供商默认值；custom 模式下必填）
# 示例：qwen-max / gpt-4o / llama3 / deepseek-chat
VITE_LLM_MODEL=

# 自定义 API 地址（custom 模式下必填，其他模式可留空或用于覆盖默认地址）
# 示例：http://localhost:11434/v1（Ollama）
#       https://api.deepseek.com/v1（DeepSeek）
VITE_LLM_BASE_URL=
